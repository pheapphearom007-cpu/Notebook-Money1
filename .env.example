# ==============================================================================
# SIEVPHOV BANCHY (សៀវភៅបញ្ជី) - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CENTRAL SERVER & DEPLOYMENT CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# The public canonical URL of your website (used to build password-reset links)
# Production example: APP_URL=https://notebook-money1.onrender.com
# Localhost example:  APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SMTP EMAIL CONFIGURATION (Password Reset Delivery)
# ------------------------------------------------------------------------------
# Configure these to deliver real password reset emails in production.
# Examples: Gmail, Brevo, SendGrid, Amazon SES, Mailgun, Postmark
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM="សៀវភៅបញ្ជី (Sievphov Banchy)" <your-email@gmail.com>

# ------------------------------------------------------------------------------
# 3. SUPABASE CLOUD (Optional / Alternative Central Backend)
# ------------------------------------------------------------------------------
# If you prefer using Supabase Auth & PostgreSQL instead of the central Node database:
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
